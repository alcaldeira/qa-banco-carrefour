{
  "name": "professional-sauce-demo-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Professional Playwright automation suite for Sauce Demo built on the reference project",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
